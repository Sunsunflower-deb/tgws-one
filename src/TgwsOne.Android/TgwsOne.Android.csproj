<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>TgwsOne.Android</RootNamespace>
    <AssemblyName>TgwsOne.Android</AssemblyName>
    <ApplicationId>io.github.sunsunflowerdeb.tgwsone</ApplicationId>
    <ApplicationTitle>TgwsOne</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- Android 8.0: the version the plan's default table fixes. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <!-- The plan's default table fixes the three ABIs. android-arm is the RID for armeabi-v7a; the plural property is what
         makes one publish cover all of them instead of only the host default. -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <!-- The artifact of `make android` is installed with a plain `adb install`, so the assemblies must travel
         inside the APK. Debug builds otherwise use fast deployment, which leaves them on the build machine. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- A release APK is signed by the owner's key (E5.5); debug builds use the SDK's debug key and must not
         ask for one here. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TgwsOne.Mobile\TgwsOne.Mobile.csproj" />
    <ProjectReference Include="..\TgwsOne.Engine\TgwsOne.Engine.csproj" />
    <ProjectReference Include="..\TgwsOne.Shared\TgwsOne.Shared.csproj" />
  </ItemGroup>

</Project>

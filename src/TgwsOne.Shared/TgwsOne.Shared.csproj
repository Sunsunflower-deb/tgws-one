<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The android target is opt-in (TGWS_ENABLE_ANDROID=true): desktop restore/publish walks into it
         otherwise and demands the Android workload plus Mono runtime packs that nuget.org does not carry. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(TGWS_ENABLE_ANDROID)' == 'true'">net10.0;net10.0-android</TargetFrameworks>
    <!-- The namespace stays TgwsOne.Core: these types moved out of the desktop assembly, not out of the API. -->
    <RootNamespace>TgwsOne.Core</RootNamespace>
    <AssemblyName>TgwsOne.Shared</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TgwsOne.Core.Tests" />
  </ItemGroup>

</Project>

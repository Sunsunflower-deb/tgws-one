<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
    <RootNamespace>TgwsOne.Engine</RootNamespace>
    <AssemblyName>TgwsOne.Engine</AssemblyName>
    <!-- The proxy engine is a library: the application hosts it in its own process (and the engine command line
         runs the same code headlessly). No UI or Avalonia references, so the CLI paths stay light. -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TgwsOne.Engine.Tests" />
    <InternalsVisibleTo Include="TgwsOne.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TgwsOne.Shared\TgwsOne.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Operator rotations travel with the engine: the mobile app has no strategies folder to read at runtime. -->
    <EmbeddedResource Include="Desync/Rotations/*.rotation"
                      LogicalName="TgwsOne.Engine.Desync.Rotations.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Desync/Rotations/mcc-mnc.txt"
                      LogicalName="TgwsOne.Engine.Desync.Rotations.mcc-mnc.txt" />
  </ItemGroup>

</Project>

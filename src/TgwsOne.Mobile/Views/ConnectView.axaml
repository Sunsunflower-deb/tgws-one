<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TgwsOne.Mobile.Views.ConnectView">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,18" Spacing="14">

      <TextBlock Classes="title" Text="Подключение к Telegram" />

      <TextBlock TextWrapping="Wrap"
                 Text="Откройте ссылку в Telegram — он добавит прокси сам. Если Telegram не установлен, скопируйте ссылку и вставьте её вручную." />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="caption" Text="Ссылка для Telegram" />
          <SelectableTextBlock x:Name="LinkText" Text="{Binding Link}" TextWrapping="Wrap"
                               FontFamily="monospace" FontSize="12" />
          <WrapPanel>
            <Button x:Name="OpenTelegramButton" Content="Открыть в Telegram" Margin="0,0,8,8"
                    Command="{Binding OpenInTelegramCommand}" />
            <Button x:Name="CopyButton" Content="Копировать" Margin="0,0,8,8"
                    Command="{Binding CopyLinkCommand}" />
            <Button x:Name="ShareButton" Content="Поделиться" Margin="0,0,8,8"
                    Command="{Binding ShareLinkCommand}" />
          </WrapPanel>
          <TextBlock x:Name="NoticeText" Classes="caption" Text="{Binding Notice}"
                     IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock x:Name="ErrorText" Classes="error" Text="{Binding ErrorText}"
                     IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
